@page "/feedback"
@inject NavigationManager Nav

<div class="min-h-screen flex">

    <!-- Sidebar -->
    <aside class="hidden md:flex flex-col w-64 glass-strong border-r border-white/10 fixed inset-y-0 left-0 z-30">
        <div class="px-6 h-16 flex items-center border-b border-white/10 flex-shrink-0">
            <a href="/" class="flex items-center gap-2.5">
                <div class="w-8 h-8 bg-sky-500 rounded-lg flex items-center justify-center shadow-lg shadow-sky-500/40">
                    <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <span class="text-base font-bold text-white" style="font-family:'DM Sans',sans-serif">DocTient</span>
            </a>
        </div>
        <div class="px-5 py-5 border-b border-white/10 flex-shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-sky-500/20 border border-sky-500/30 rounded-full flex items-center justify-center text-sky-400 text-sm font-bold flex-shrink-0">AR</div>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-white truncate">Alex Reyes</p>
                    <p class="text-xs text-white/40 truncate">Patient</p>
                </div>
            </div>
        </div>
        <nav class="flex-1 px-4 py-4 space-y-0.5 overflow-y-auto" aria-label="Primary">
            @foreach (var item in SidebarItems)
            {
                if (item.Href == "#")
                {
                    <span title="Coming soon"
                          class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-white/30 cursor-not-allowed select-none">
                        <span class="text-base opacity-60">@item.Icon</span>
                        @item.Label
                    </span>
                }
                else
                {
                    <a href="@item.Href" aria-current="@(item.Active ? "page" : null)"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all duration-200 @(item.Active ? "bg-sky-500/20 text-sky-300 border border-sky-500/20 font-semibold" : "text-white/50 hover:bg-white/10 hover:text-white border border-transparent")">
                        <span class="text-base">@item.Icon</span>
                        @item.Label
                    </a>
                }
            }
        </nav>
        <div class="px-4 py-5 border-t border-white/10 flex-shrink-0">
            <button @onclick='() => Nav.NavigateTo("/login")'
                    class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-white/40 hover:bg-red-500/10 hover:text-red-400 transition-all">
                <span class="text-base">🚪</span> Sign Out
            </button>
        </div>
    </aside>

    <!-- Main -->
    <div class="flex-1 md:ml-64 flex flex-col min-h-screen">

        <header class="sticky top-0 z-20 glass-strong border-b border-white/10 flex-shrink-0">
            <div class="px-6 h-16 flex items-center justify-between">
                <div>
                    <h1 class="text-sm font-semibold text-white">Rate your visit ⭐</h1>
                    <p class="text-xs text-white/40">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
                </div>
                <button @onclick='() => Nav.NavigateTo("/dashboard")'
                        class="px-3.5 py-2 text-xs font-medium text-white glass-inset hover:bg-white/10 rounded-xl transition">
                    ← Dashboard
                </button>
            </div>
        </header>

        <main class="flex-1 px-6 py-6 max-w-6xl mx-auto w-full space-y-6">

            <div class="anim-fade-up">
                <h2 class="text-xl font-bold text-white tracking-tight text-balance" style="font-family:'DM Sans',sans-serif">How was your consultation?</h2>
                <p class="text-sm text-white/50 mt-1 max-w-xl leading-relaxed">Your rating helps Dr. Cruz and other patients. It only takes a few seconds.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">

                <!-- Rating form : true glass — inner edge refraction + tinted shadow -->
                <div class="lg:col-span-3 glass ring-1 ring-inset ring-white/10 rounded-2xl p-6 card-lift anim-fade-up delay-200">
                    <div class="flex items-center gap-3 mb-4 pb-5 border-b border-white/10">
                        <div class="w-12 h-12 bg-sky-500 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0 shadow-lg shadow-sky-500/30">RC</div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-white">Dr. Rafael Cruz</p>
                            <p class="text-xs text-white/50">General Practitioner · Makati Med</p>
                        </div>
                        <span class="flex items-center gap-1.5 text-xs text-emerald-400 font-medium shrink-0">
                            <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full inline-block animate-pulse"></span>Online
                        </span>
                    </div>

                    <div class="mb-5">
                        <label class="block text-sm font-semibold text-white mb-1.5">Which visit are you rating? <span class="text-red-400">*</span></label>
                        <select @bind="SelectedVisit"
                                class="w-full px-3.5 py-2.5 text-sm rounded-xl glass-input text-white focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-400/50 transition">
                            @foreach (var v in Visits)
                            {
                                <option value="@v" class="bg-slate-800 text-white">@v</option>
                            }
                        </select>
                        <p class="text-xs text-white/30 mt-1.5">Linked to your Health History — vitals from this visit stay attached to your review.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMsg))
                    {
                        <div class="mb-4 px-4 py-3 bg-red-500/20 border border-red-500/30 rounded-xl text-sm text-red-300 anim-fade-in">
                            @ErrorMsg
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(SuccessMsg))
                    {
                        <div class="mb-4 px-4 py-3 bg-emerald-500/20 border border-emerald-500/30 rounded-xl text-sm text-emerald-300 anim-fade-in">
                            @SuccessMsg
                        </div>
                    }

                    <p class="text-sm font-semibold text-white mb-1">Your rating <span class="text-red-400">*</span></p>
                    <p class="text-xs text-white/40 mb-3">Tap a star to rate — 1 = Poor, 5 = Excellent</p>
                    <div class="flex items-center gap-1.5 mb-1" @onmouseleave="() => HoverRating = 0">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var star = i;
                            var filled = star <= (HoverRating > 0 ? HoverRating : SelectedRating);
                            <button @onclick="() => SetRating(star)"
                                    @onmouseenter="() => HoverRating = star"
                                    class="text-3xl leading-none transition-transform duration-200 hover:scale-110 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/60 rounded @(filled ? "text-amber-400" : "text-white/20 hover:text-white/40")"
                                    title="@star star"
                                    aria-label="Rate @star star">
                                ★
                            </button>
                        }
                        <span class="ml-2 text-sm font-medium @(SelectedRating > 0 ? "text-amber-300" : "text-white/30")">
                            @(SelectedRating > 0 ? RatingLabels[SelectedRating - 1] : "No rating yet")
                        </span>
                    </div>
                    <p class="text-xs text-white/30 mb-5 h-4">@(HoverRating > 0 ? $"Click to rate {HoverRating} star{(HoverRating > 1 ? "s" : "")}" : "")</p>

                    <p class="text-sm font-semibold text-white mb-3">What stood out? <span class="text-white/30 font-normal">(optional)</span></p>
                    <div class="flex flex-wrap gap-2 mb-5">
                        @foreach (var tag in AllTags)
                        {
                            var active = SelectedTags.Contains(tag);
                            <button @onclick="() => ToggleTag(tag)"
                                    class="px-3 py-1.5 rounded-full text-xs font-medium border transition @(active ? "bg-sky-500/20 text-sky-300 border-sky-500/40" : "bg-white/5 text-white/50 border-white/10 hover:border-white/25 hover:text-white")">
                                @(active ? "✓ " : "")@tag
                            </button>
                        }
                    </div>

                    <div class="flex items-center justify-between mb-1.5">
                        <label class="text-sm font-semibold text-white">Your comment <span class="text-red-400">*</span></label>
                        <span class="text-xs tabular-nums @(Comment.Length > MaxComment ? "text-red-400" : "text-white/30")">@(Comment?.Length ?? 0) / @MaxComment</span>
                    </div>
                    <textarea @bind="Comment" @bind:event="oninput" rows="4" maxlength="@MaxComment"
                              placeholder="e.g. Doctor explained everything clearly and the follow-up was quick..."
                              class="w-full px-3.5 py-3 text-sm rounded-xl glass-input text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-400/50 transition resize-none leading-relaxed"></textarea>

                    <div class="flex items-center gap-3 mt-5">
                        <button @onclick="HandleSubmit" disabled="@Loading"
                                class="flex-1 py-2.5 text-sm font-semibold text-white bg-sky-500 hover:bg-sky-400 active:scale-[0.98] rounded-xl transition duration-200 shadow-lg shadow-sky-500/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300/70 disabled:opacity-50 disabled:cursor-not-allowed disabled:active:scale-100">
                            @(Loading ? "Posting..." : "Post Review")
                        </button>
                        <button @onclick="ResetForm"
                                class="px-4 py-2.5 text-sm font-medium text-white/60 bg-white/5 hover:bg-white/10 active:scale-[0.98] border border-white/10 rounded-xl transition duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30">
                            Clear
                        </button>
                    </div>
                </div>

                <!-- Summary -->
                <div class="lg:col-span-2 space-y-4">
                    <div class="glass ring-1 ring-inset ring-white/10 rounded-2xl p-6 card-lift anim-fade-up delay-300 text-center">
                        <p class="text-xs font-semibold text-white/40 uppercase tracking-wider mb-2">Average Rating</p>
                        <p class="text-5xl font-bold text-white tabular-nums tracking-tight" style="font-family:'DM Sans',sans-serif">@AverageRating.ToString("0.0")</p>
                        <div class="flex items-center justify-center gap-0.5 my-3 text-2xl">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="@(i <= Math.Round(AverageRating) ? "text-amber-400" : "text-white/20")">★</span>
                            }
                        </div>
                        <p class="text-xs text-white/40">Based on @Reviews.Count review@(Reviews.Count == 1 ? "" : "s")</p>
                        <div class="mt-5 space-y-2 text-left">
                            @for (int s = 5; s >= 1; s--)
                            {
                                var count = Reviews.Count(r => r.Rating == s);
                                var pct = Reviews.Count == 0 ? 0 : (int)Math.Round(count * 100.0 / Reviews.Count);
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-white/50 w-6 shrink-0">@s ★</span>
                                    <div class="flex-1 h-2 bg-white/10 rounded-full overflow-hidden">
                                        <div class="h-full bg-amber-400/80 rounded-full transition-all" style="width:@pct%"></div>
                                    </div>
                                    <span class="text-xs text-white/30 w-8 text-right shrink-0">@pct%</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="bg-sky-500/10 backdrop-blur-[6px] backdrop-saturate-150 border border-sky-500/20 rounded-2xl p-5 anim-fade-up delay-400">
                        <p class="text-sm font-semibold text-sky-300 mb-1">💡 Be kind & specific</p>
                        <p class="text-xs text-white/50 leading-relaxed">Mention what helped — clear explanations, short waits, caring follow-up. Avoid sharing sensitive medical details publicly.</p>
                    </div>
                </div>
            </div>

            <!-- Reviews list -->
            <div class="glass rounded-2xl overflow-hidden card-lift anim-fade-up delay-500">
                <div class="px-5 py-4 border-b border-white/10 flex items-center justify-between">
                    <p class="text-sm font-semibold text-white">Patient Reviews (@Reviews.Count)</p>
                    <span class="text-xs text-white/40">Newest first · front-end only</span>
                </div>
                @if (Reviews.Count == 0)
                {
                    <div class="px-5 py-10 text-center">
                        <p class="text-3xl mb-2">💬</p>
                        <p class="text-sm font-medium text-white">No reviews yet</p>
                        <p class="text-xs text-white/40 mt-1">Be the first to rate your visit above.</p>
                    </div>
                }
                @foreach (var r in Reviews)
                {
                    <div class="px-5 py-4 border-b border-white/5 last:border-0 hover:bg-white/5 transition">
                        <div class="flex items-start gap-3">
                            <div class="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 @(r.Mine ? "bg-sky-500/20 border border-sky-500/30 text-sky-300" : "bg-white/10 border border-white/10 text-white/60")">@r.Initials</div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <p class="text-sm font-semibold text-white">@r.Name</p>
                                    @if (r.Mine)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-sky-500/20 text-sky-300 border border-sky-500/30">You</span>
                                    }
                                    <span class="text-xs text-white/30">@r.Date.ToString("MMM d, h:mm tt")</span>
                                </div>
                                <div class="flex items-center gap-1 my-1 text-base leading-none">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= r.Rating ? "text-amber-400" : "text-white/20")">★</span>
                                    }
                                    <span class="ml-2 text-[11px] text-white/30 truncate">📋 @r.Visit</span>
                                </div>
                                @if (r.Tags.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-1.5 my-2">
                                        @foreach (var t in r.Tags)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-white/5 text-white/50 border border-white/10">@t</span>
                                        }
                                    </div>
                                }
                                <p class="text-sm text-white/70 leading-relaxed">@r.Comment</p>
                                <div class="flex items-center gap-3 mt-2">
                                    <button @onclick="() => r.Helpful++" class="text-xs text-white/40 hover:text-sky-300 transition">
                                        👍 Helpful (@r.Helpful)
                                    </button>
                                    @if (r.Mine)
                                    {
                                        <button @onclick="() => DeleteReview(r)" class="text-xs text-white/30 hover:text-red-400 transition">Delete</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </main>
    </div>
</div>

@code {
    const int MaxComment = 500;

    record SidebarItem(string Icon, string Label, string Href, bool Active);
    SidebarItem[] SidebarItems = [
        new("🏠", "Dashboard", "/dashboard", false),
        new("❤️", "My Health", "#", false),
        new("📋", "Health History", "#", false),
        new("💊", "Medications", "#", false),
        new("⭐", "Rate Doctor", "/feedback", true),
        new("💬", "Messages", "#", false),
        new("👤", "Profile", "#", false),
    ];

    string[] RatingLabels = ["Poor", "Fair", "Good", "Very Good", "Excellent"];
    string[] AllTags = ["Friendly", "On-time", "Clear explanation", "Listens well", "Caring follow-up", "Clean clinic"];

    // DocTient-relevant: visits mirror Dashboard Recent Health Records dates
    string[] Visits = [
        "Sep 17 · Follow-up — BP 118/76, HR 72 bpm",
        "Sep 10 · General Checkup — BP 121/79, HR 75 bpm",
        "Sep 03 · Lab Review — Blood Oxygen 98%",
    ];
    string SelectedVisit = "Sep 17 · Follow-up — BP 118/76, HR 72 bpm";

    int SelectedRating = 0;
    int HoverRating = 0;
    string Comment = "";
    HashSet<string> SelectedTags = new();
    string ErrorMsg = "";
    string SuccessMsg = "";
    bool Loading = false;

    class Review
    {
        public string Name = "";
        public string Initials = "";
        public int Rating = 5;
        public string Comment = "";
        public List<string> Tags = new();
        public string Visit = "";
        public DateTime Date = DateTime.Now;
        public int Helpful = 0;
        public bool Mine = false;
    }

    List<Review> Reviews = new()
    {
        new() { Name = "Maria Santos", Initials = "MS", Rating = 5, Comment = "Dr. Cruz explained my lab results clearly and never rushed. Highly recommended!", Tags = new() { "Clear explanation", "Friendly" }, Visit = "Sep 10 · General Checkup — BP 121/79, HR 75 bpm", Date = DateTime.Now.AddDays(-2), Helpful = 12 },
        new() { Name = "Jose Dela Cruz", Initials = "JD", Rating = 4, Comment = "Good follow-up after my checkup. Waiting time was a bit long but care was excellent.", Tags = new() { "Caring follow-up" }, Visit = "Sep 03 · Lab Review — Blood Oxygen 98%", Date = DateTime.Now.AddDays(-5), Helpful = 5 },
    };

    double AverageRating => Reviews.Count == 0 ? 0 : Reviews.Average(r => r.Rating);

    void SetRating(int value)
    {
        SelectedRating = value;
        ErrorMsg = "";
    }

    void ToggleTag(string tag)
    {
        if (!SelectedTags.Remove(tag))
            SelectedTags.Add(tag);
    }

    void ResetForm()
    {
        SelectedRating = 0;
        HoverRating = 0;
        Comment = "";
        SelectedTags.Clear();
        SelectedVisit = Visits[0];
        ErrorMsg = "";
        SuccessMsg = "";
    }

    async Task HandleSubmit()
    {
        ErrorMsg = "";
        SuccessMsg = "";
        if (string.IsNullOrWhiteSpace(SelectedVisit))
        {
            ErrorMsg = "Please choose which visit you are rating.";
            return;
        }
        if (SelectedRating == 0)
        {
            ErrorMsg = "Please select a star rating before posting.";
            return;
        }
        if (string.IsNullOrWhiteSpace(Comment))
        {
            ErrorMsg = "Please write a short comment about your visit.";
            return;
        }
        if (Comment.Length > MaxComment)
        {
            ErrorMsg = $"Comment must be {MaxComment} characters or less.";
            return;
        }
        Loading = true;
        await Task.Delay(600);
        Loading = false;

        Reviews.Insert(0, new Review
        {
            Name = "Alex Reyes",
            Initials = "AR",
            Rating = SelectedRating,
            Comment = Comment.Trim(),
            Tags = SelectedTags.ToList(),
            Visit = SelectedVisit,
            Date = DateTime.Now,
            Mine = true
        });
        SuccessMsg = "Thanks! Your review was posted.";
        SelectedRating = 0;
        HoverRating = 0;
        Comment = "";
        SelectedTags.Clear();
        SelectedVisit = Visits[0];
    }

    void DeleteReview(Review review)
    {
        Reviews.Remove(review);
        SuccessMsg = "";
    }
}

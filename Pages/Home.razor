@page "/"
@inject NavigationManager Nav

<div class="min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="sticky top-0 z-40 bg-white/5 backdrop-blur-xl border-b border-white/10 anim-fade-in">
        <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-2.5">
                <div class="w-8 h-8 bg-sky-500 rounded-lg flex items-center justify-center shadow-lg shadow-sky-500/40">
                    <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <span class="text-lg font-bold text-white" style="font-family:'DM Sans',sans-serif">DocTient</span>
            </a>
            <!-- Nav links -->
            <nav class="hidden md:flex items-center gap-8">
                <a href="#features" class="text-sm text-white/60 hover:text-white transition">Features</a>
                <a href="#about" class="text-sm text-white/60 hover:text-white transition">About</a>
            </nav>
            <!-- Auth buttons -->
            <div class="flex items-center gap-3">
                <button @onclick='() => Nav.NavigateTo("/login")'
                        class="px-4 py-2 text-sm font-medium text-white bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg transition backdrop-blur-sm">
                    Sign In
                </button>
                <button @onclick='() => Nav.NavigateTo("/signup")'
                        class="px-4 py-2 text-sm font-medium text-white bg-sky-500 hover:bg-sky-400 rounded-lg transition shadow-lg shadow-sky-500/30">
                    Get Started
                </button>
            </div>
        </div>
    </header>

    <!-- Hero -->
    <section class="flex-1 max-w-6xl mx-auto px-6 pt-24 pb-20 flex flex-col md:flex-row items-center gap-16 w-full">
        <div class="flex-1 anim-fade-left">
            <span class="inline-block px-3 py-1 bg-sky-500/20 text-sky-300 text-xs font-semibold rounded-full mb-5 tracking-widest uppercase border border-sky-500/30">
                Healthcare Platform
            </span>
            <h1 class="text-5xl md:text-6xl font-bold text-white leading-tight mb-5" style="font-family:'DM Sans',sans-serif">
                Connect with<br />your doctor<br /><span class="text-sky-400">easily.</span>
            </h1>
            <p class="text-lg text-white/60 mb-8 max-w-md leading-relaxed">
                Monitor your vitals, share health data, and stay connected with your doctor — all in one place, between consultations.
            </p>
            <div class="flex items-center gap-3 flex-wrap">
                <button @onclick='() => Nav.NavigateTo("/signup")'
                        class="px-6 py-3 text-sm font-semibold text-white bg-sky-500 hover:bg-sky-400 rounded-xl transition shadow-lg shadow-sky-500/30">
                    Get Started — It's Free
                </button>
                <a href="#features"
                   class="px-6 py-3 text-sm font-medium text-white bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl transition backdrop-blur-sm">
                    Learn More
                </a>
            </div>
            <!-- Trust badges -->
            <div class="flex items-center gap-4 mt-10 flex-wrap">
                <div class="flex items-center gap-1.5 text-xs text-white/50">
                    <span class="text-emerald-400">✓</span> HIPAA-aligned
                </div>
                <div class="flex items-center gap-1.5 text-xs text-white/50">
                    <span class="text-emerald-400">✓</span> End-to-end encrypted
                </div>
                <div class="flex items-center gap-1.5 text-xs text-white/50">
                    <span class="text-emerald-400">✓</span> Always accessible
                </div>
            </div>
        </div>

        <!-- Hero Card Preview -->
        <div class="flex-1 w-full max-w-sm md:max-w-none relative anim-fade-right">
            <!-- Glow orb behind card -->
            <div class="absolute inset-0 bg-sky-500/10 rounded-3xl blur-3xl -z-10 anim-glow"></div>
            <!-- Floating badges -->
            <div class="absolute -top-4 -right-2 hidden lg:flex items-center gap-1.5 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl px-3 py-1.5 shadow-lg anim-badge">
                <span class="text-emerald-400 text-xs">✓</span>
                <span class="text-xs text-white/70 font-medium">HIPAA Aligned</span>
            </div>
            <div class="absolute -bottom-4 -left-2 hidden lg:flex items-center gap-1.5 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl px-3 py-1.5 shadow-lg anim-badge delay-300">
                <span class="text-sky-400 text-xs">🔒</span>
                <span class="text-xs text-white/70 font-medium">End-to-End Encrypted</span>
            </div>
            <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-6 shadow-2xl shadow-black/40 anim-float">
                <!-- Vitals preview card -->
                <div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-5 mb-4">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-xs font-semibold text-white/50 uppercase tracking-wider">Today's Vitals</span>
                        <span class="text-xs text-white/30">Sep 17 · 7:30 AM</span>
                    </div>
                    @foreach (var v in HeroVitals)
                    {
                        <div class="flex items-center justify-between py-2.5 border-b border-white/10 last:border-0">
                            <span class="text-sm text-white/70">@v.Label</span>
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-semibold @v.Color">@v.Value</span>
                                <span class="px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Normal</span>
                            </div>
                        </div>
                    }
                </div>
                <!-- Doctor preview -->
                <div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-2xl p-4 flex items-center gap-3">
                    <div class="w-10 h-10 bg-sky-500 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0 shadow-lg shadow-sky-500/30">RC</div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-white">Dr. Rafael Cruz</p>
                        <p class="text-xs text-white/50 truncate">Your blood pressure looks good — keep it up.</p>
                    </div>
                    <span class="flex items-center gap-1 text-xs text-emerald-400 font-medium flex-shrink-0">
                        <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full inline-block animate-pulse"></span>Online
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section id="features" class="py-24">
        <div class="max-w-6xl mx-auto px-6">
            <div class="text-center mb-14 anim-fade-up">
                <h2 class="text-3xl font-bold text-white mb-3" style="font-family:'DM Sans',sans-serif">How DocTient works</h2>
                <p class="text-white/50 max-w-lg mx-auto">A continuous loop between patient and doctor — from logging vitals to receiving feedback.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var (f, i) in Features.Select((f, i) => (f, i)))
                {
                    <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-7 shadow-xl shadow-black/20 card-lift anim-fade-up delay-@((i + 1) * 200)">
                        <div class="text-3xl mb-4">@f.Icon</div>
                        <h3 class="text-base font-semibold text-white mb-2">@f.Title</h3>
                        <p class="text-sm text-white/50 leading-relaxed">@f.Desc</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- About / Trust -->
    <section id="about" class="py-24 w-full">
        <div class="max-w-6xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div class="anim-fade-left">
                    <h2 class="text-3xl font-bold text-white mb-6" style="font-family:'DM Sans',sans-serif">Built for patients<br />and doctors alike.</h2>
                    <div class="space-y-5">
                        @foreach (var role in Roles)
                        {
                            <div>
                                <p class="text-sm font-semibold text-sky-400 mb-2">@role.Role</p>
                                <ul class="space-y-1.5">
                                    @foreach (var point in role.Points)
                                    {
                                        <li class="flex items-start gap-2 text-sm text-white/60">
                                            <span class="w-4 h-4 flex-shrink-0 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center text-[10px] mt-0.5 border border-emerald-500/30">✓</span>
                                            @point
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-8 shadow-xl shadow-black/20 card-lift anim-fade-right">
                    <h3 class="text-xl font-bold text-white mb-3" style="font-family:'DM Sans',sans-serif">Secure &amp; Private</h3>
                    <p class="text-sm text-white/60 leading-relaxed mb-5">Your health data is shared only with your connected doctor — never with third parties.</p>
                    @foreach (var t in TrustPoints)
                    {
                        <div class="flex items-center gap-2.5 text-sm text-white/70 mb-2.5">
                            <span class="text-sky-400">🔒</span> @t
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-20">
        <div class="max-w-4xl mx-auto px-6">
            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-16 text-center shadow-2xl shadow-black/30 anim-fade-up">
                <h2 class="text-3xl font-bold text-white mb-3" style="font-family:'DM Sans',sans-serif">Ready to get started?</h2>
                <p class="text-white/50 mb-8">Join DocTient and stay connected with your healthcare.</p>
                <div class="flex items-center justify-center gap-4 flex-wrap">
                    <button @onclick='() => Nav.NavigateTo("/signup")'
                            class="px-6 py-3 text-sm font-semibold text-white bg-sky-500 hover:bg-sky-400 rounded-xl transition shadow-lg shadow-sky-500/30">
                        Create Account
                    </button>
                    <button @onclick='() => Nav.NavigateTo("/login")'
                            class="px-6 py-3 text-sm font-medium text-white bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl transition backdrop-blur-sm">
                        Sign In
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-white/10 text-white/40 text-sm py-10 text-center">
        <p class="text-white font-semibold mb-1" style="font-family:'DM Sans',sans-serif">DocTient</p>
        <p>© 2026 DocTient. Connect with your doctor easily.</p>
    </footer>
</div>

@code {
    record HeroVital(string Label, string Value, string Color);
    record Feature(string Icon, string Title, string Desc);
    record RoleItem(string Role, string[] Points);

    HeroVital[] HeroVitals = [
        new("Blood Pressure", "118/76 mmHg", "text-white"),
        new("Heart Rate",     "72 bpm",      "text-sky-400"),
        new("Blood Oxygen",   "98%",         "text-emerald-400"),
    ];

    Feature[] Features = [
        new("📊", "Record Health Data",      "Log vital signs — blood pressure, heart rate, temperature, oxygen, and weight — anytime from any device."),
        new("🔗", "Shared with Your Doctor", "Your doctor sees your data in real time, enabling better oversight between consultations."),
        new("💬", "Stay Connected",          "Message your doctor directly and receive timely notifications about your health."),
    ];

    RoleItem[] Roles = [
        new("Patients", ["Track vitals daily", "View medication reminders", "Access full health history", "Message your doctor anytime"]),
        new("Doctors",  ["Monitor all patients centrally", "Review historical health data", "Identify patients needing attention", "Communicate securely"]),
    ];

    string[] TrustPoints = [
        "End-to-end encrypted messages",
        "Role-based access control",
        "No third-party data sharing",
        "HIPAA-aligned practices",
    ];
}

@page "/dashboard"
@inject NavigationManager Nav

<div class="min-h-screen flex">

    <!-- Sidebar -->
    <aside class="hidden md:flex flex-col w-64 glass-strong border-r border-white/10 fixed inset-y-0 left-0 z-30">
        <!-- Logo -->
        <div class="px-6 h-16 flex items-center border-b border-white/10 flex-shrink-0">
            <a href="/" class="flex items-center gap-2.5">
                <div class="w-8 h-8 bg-sky-500 rounded-lg flex items-center justify-center shadow-lg shadow-sky-500/40">
                    <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <span class="text-base font-bold text-white" style="font-family:'DM Sans',sans-serif">DocTient</span>
            </a>
        </div>
        <!-- Patient -->
        <div class="px-5 py-5 border-b border-white/10 flex-shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-sky-500/20 border border-sky-500/30 rounded-full flex items-center justify-center text-sky-400 text-sm font-bold flex-shrink-0">AR</div>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-white truncate">Alex Reyes</p>
                    <p class="text-xs text-white/40 truncate">Patient</p>
                </div>
            </div>
        </div>
        <!-- Nav -->
        <nav class="flex-1 px-4 py-4 space-y-0.5 overflow-y-auto">
            @foreach (var item in SidebarItems)
            {
                <a href="@item.Href"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all @(item.Active ? "bg-sky-500/20 text-sky-300 border border-sky-500/20 font-semibold" : "text-white/50 hover:bg-white/10 hover:text-white")">
                    <i class="@item.Icon text-sm w-5 text-center"></i>
                    @item.Label
                </a>
            }
        </nav>
        <!-- Logout -->
        <div class="px-4 py-5 border-t border-white/10 flex-shrink-0">
            <button @onclick='() => Nav.NavigateTo("/login")'
                    class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-white/40 hover:bg-red-500/10 hover:text-red-400 transition-all">
                <i class="fa-solid fa-right-from-bracket text-sm w-5 text-center"></i> Sign Out
            </button>
        </div>
    </aside>

    <!-- Main -->
    <div class="flex-1 md:ml-64 flex flex-col min-h-screen">

        <!-- Top bar -->
        <header class="sticky top-0 z-20 glass-strong border-b border-white/10 flex-shrink-0">
            <div class="px-6 h-16 flex items-center justify-between">
                <div>
                    <h1 class="text-sm font-semibold text-white">Good morning, Alex</h1>
                    <p class="text-xs text-white/40">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
                </div>
                <div class="flex items-center gap-2">
                    <button class="relative p-2 rounded-xl text-white/40 hover:bg-white/10 hover:text-white/80 transition">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border-2 border-transparent animate-pulse"></span>
                    </button>
                    <div class="w-8 h-8 bg-sky-500/20 border border-sky-500/30 rounded-full flex items-center justify-center text-sky-400 text-xs font-bold">AR</div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <main class="flex-1 px-6 py-6 max-w-6xl mx-auto w-full space-y-6 relative">
            <!-- Dashboard ambient accents -->
            <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
                <div class="dash-blob" style="width:420px;height:300px;left:-120px;top:-80px;background:radial-gradient(circle,rgba(56,189,248,0.28),transparent 70%)"></div>
                <div class="dash-blob" style="width:380px;height:280px;right:-100px;top:40px;background:radial-gradient(circle,rgba(244,63,94,0.20),transparent 70%);animation-delay:-4s"></div>
                <div class="dash-blob" style="width:460px;height:320px;left:30%;bottom:-160px;background:radial-gradient(circle,rgba(99,102,241,0.22),transparent 70%);animation-delay:-8s"></div>
            </div>

            <!-- Vitals Bento — heart centerpiece, not floating cards -->
            <div class="anim-fade-up relative">
                <div class="flex items-center justify-between mb-4 relative">
                    <div>
                        <h2 class="text-sm font-semibold text-white">How's your health going today?</h2>
                        <p class="text-xs text-white/40 mt-0.5">Live from your connected devices · Last logged: 7:30 AM today</p>
                    </div>
                    <span class="flex items-center gap-1.5 text-xs text-emerald-300 font-medium px-3 py-1 rounded-full glass-inset">
                        <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>Live
                    </span>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 relative">
                    <!-- Heart hero -->
                    <div class="lg:col-span-2 glass rounded-3xl p-6 card-lift relative overflow-hidden">
                        <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-rose-500/20 blur-3xl pointer-events-none"></div>
                        <div class="absolute -left-16 -bottom-20 w-72 h-72 rounded-full bg-sky-500/15 blur-3xl pointer-events-none"></div>
                        <div class="flex flex-col sm:flex-row gap-6 relative">
                            <div class="flex-1 min-w-0">
                                <p class="text-xs font-semibold text-rose-200/80 uppercase tracking-wider mb-2">Heart Rate</p>
                                <p class="text-6xl font-bold text-white tracking-tight leading-none" style="font-family:'DM Sans',sans-serif">@Vitals[1].Value <span class="text-lg font-medium text-rose-300">bpm</span></p>
                                <span class="inline-block mt-3 px-2.5 py-1 rounded-full text-[11px] font-medium @Vitals[1].BadgeClass">@Vitals[1].Status · Resting</span>
                                <svg viewBox="0 0 300 60" class="w-full h-14 mt-4" preserveAspectRatio="none" aria-hidden="true">
                                    <defs>
                                        <linearGradient id="ecgGrad" x1="0" y1="0" x2="1" y2="0">
                                            <stop offset="0%" stop-color="#fb7185" stop-opacity="0.2" />
                                            <stop offset="50%" stop-color="#fb7185" stop-opacity="1" />
                                            <stop offset="100%" stop-color="#38bdf8" stop-opacity="1" />
                                        </linearGradient>
                                    </defs>
                                    <line x1="0" y1="30" x2="300" y2="30" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
                                    <polyline points="0,30 40,30 55,30 62,12 70,48 78,22 86,30 130,30 145,30 152,8 160,52 168,18 176,30 220,30 235,30 242,14 250,44 258,26 266,30 300,30"
                                              fill="none" stroke="url(#ecgGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ecg-flow" />
                                </svg>
                                <p class="text-[11px] text-white/30 mt-2">7-day avg 74 bpm · steady pulse</p>
                            </div>
                            <div class="relative w-full sm:w-52 shrink-0 flex items-center justify-center min-h-44">
                                <svg viewBox="0 0 24 24" class="w-36 h-36 heart-beat" style="filter:drop-shadow(0 12px 32px rgba(244,63,94,0.45))" aria-hidden="true">
                                    <defs>
                                        <linearGradient id="heartGrad" x1="0" y1="0" x2="1" y2="1">
                                            <stop offset="0%" stop-color="#fb7185" />
                                            <stop offset="100%" stop-color="#e11d48" />
                                        </linearGradient>
                                    </defs>
                                    <path fill="url(#heartGrad)" d="M12 21s-7.5-4.7-10-9.3C.4 8.6 2 4.9 5.5 4.1c2-.5 4.2.1 6.5 2.7 2.3-2.6 4.5-3.2 6.5-2.7 3.5.8 5.1 4.5 3.5 7.6C19.5 16.3 12 21 12 21z" />
                                    <path fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="0.7" stroke-linecap="round" d="M4 12h3l1.5-3 2 6 1.5-4.5 1 1.5h3" />
                                </svg>
                                <span class="absolute top-1 -right-1 px-2.5 py-1 rounded-full text-[10px] font-semibold glass-inset text-sky-200 anim-badge">@Vitals[0].Value</span>
                                <span class="absolute bottom-1 -left-1 px-2.5 py-1 rounded-full text-[10px] font-semibold glass-inset text-emerald-200 anim-badge" style="animation-delay:-3s">@Vitals[3].Value%</span>
                            </div>
                        </div>
                    </div>
                    <!-- Right stack: BP + Temp -->
                    <div class="space-y-4">
                        <div class="glass rounded-2xl p-5 card-lift relative overflow-hidden">
                            <div class="absolute -right-10 -top-10 w-40 h-40 rounded-full bg-sky-500/20 blur-3xl pointer-events-none"></div>
                            <div class="flex items-center justify-between mb-2 relative">
                                <p class="text-xs font-medium text-sky-200/80">@Vitals[0].Label</p>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-medium @Vitals[0].BadgeClass">@Vitals[0].Status</span>
                            </div>
                            <p class="text-2xl font-bold text-sky-100 relative" style="font-family:'DM Sans',sans-serif">@Vitals[0].Value <span class="text-xs font-medium text-sky-300/70">@Vitals[0].Unit</span></p>
                            <div class="mt-3 space-y-2 relative">
                                <div>
                                    <div class="flex justify-between text-[10px] text-white/40 mb-1"><span>SYS 118</span><span>DIA 76</span></div>
                                    <div class="h-2 rounded-full glass-inset overflow-hidden flex gap-0.5 p-0.5">
                                        <div class="h-full rounded-full bg-gradient-to-r from-sky-400 to-emerald-400" style="width:62%"></div>
                                        <div class="h-full rounded-full bg-sky-400/40" style="width:38%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="glass rounded-2xl p-5 card-lift relative overflow-hidden">
                            <div class="absolute -right-10 -bottom-10 w-40 h-40 rounded-full bg-amber-500/20 blur-3xl pointer-events-none"></div>
                            <div class="flex items-center justify-between mb-2 relative">
                                <p class="text-xs font-medium text-amber-200/80">@Vitals[2].Label</p>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-medium @Vitals[2].BadgeClass">@Vitals[2].Status</span>
                            </div>
                            <div class="flex items-end gap-3 relative">
                                <p class="text-2xl font-bold text-amber-100" style="font-family:'DM Sans',sans-serif">@Vitals[2].Value <span class="text-xs font-medium text-amber-300/70">@Vitals[2].Unit</span></p>
                                <div class="flex-1 h-2 rounded-full glass-inset overflow-hidden mb-1.5">
                                    <div class="h-full rounded-full bg-gradient-to-r from-sky-400 via-amber-400 to-rose-400" style="width:42%"></div>
                                </div>
                            </div>
                            <p class="text-[11px] text-white/30 mt-2 relative">Fever threshold 38.0 °C · you're clear</p>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 relative">
                    <div class="glass rounded-2xl p-5 card-lift flex items-center gap-5 relative overflow-hidden">
                        <div class="absolute -left-12 -top-12 w-44 h-44 rounded-full bg-emerald-500/15 blur-3xl pointer-events-none"></div>
                        <div class="relative">
                            <svg viewBox="0 0 80 80" class="w-20 h-20 -rotate-90">
                                <circle cx="40" cy="40" r="34" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="8" />
                                <circle cx="40" cy="40" r="34" fill="none" stroke="#34d399" stroke-width="8" stroke-linecap="round" stroke-dasharray="209" stroke-dashoffset="4" />
                            </svg>
                            <span class="absolute inset-0 flex items-center justify-center text-sm font-bold text-white">@Vitals[3].Value%</span>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-emerald-200/80">@Vitals[3].Label</p>
                            <p class="text-lg font-bold text-emerald-100">@Vitals[3].Value <span class="text-xs font-medium text-emerald-300/70">@Vitals[3].Unit</span></p>
                            <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-medium @Vitals[3].BadgeClass">@Vitals[3].Status</span>
                        </div>
                    </div>
                    <div class="glass rounded-2xl p-5 card-lift relative overflow-hidden">
                        <div class="absolute -right-12 -top-12 w-44 h-44 rounded-full bg-violet-500/20 blur-3xl pointer-events-none"></div>
                        <div class="flex items-center justify-between mb-1 relative">
                            <p class="text-xs font-medium text-violet-200/80">@Vitals[4].Label</p>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-medium @Vitals[4].BadgeClass">@Vitals[4].Status</span>
                        </div>
                        <p class="text-lg font-bold text-violet-100 relative">@Vitals[4].Value <span class="text-xs font-medium text-violet-300/70">@Vitals[4].Unit</span></p>
                        <svg viewBox="0 0 200 44" class="w-full h-11 mt-2 relative" preserveAspectRatio="none" aria-hidden="true">
                            <polyline points="0,32 30,28 60,30 90,22 120,24 150,16 180,18 200,12" fill="none" stroke="#a78bfa" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                            <circle cx="200" cy="12" r="3.5" fill="#a78bfa" />
                        </svg>
                        <p class="text-[11px] text-white/30 relative">−0.3 kg this week · keep steady</p>
                    </div>
                </div>
            </div>

            <!-- Doctor row -->
            <div class="grid grid-cols-1 gap-4">
                <!-- Doctor card -->
                <div class="glass rounded-2xl p-5 card-lift anim-fade-up delay-200">
                    <p class="text-xs font-semibold text-sky-200/70 uppercase tracking-wider mb-4">Your Doctor</p>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-12 h-12 bg-sky-500 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0 shadow-lg shadow-sky-500/30">RC</div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-white">Dr. Rafael Cruz</p>
                            <p class="text-xs text-sky-200/60">General Practitioner · Makati Med</p>
                            <div class="flex items-center gap-1.5 mt-1">
                                <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
                                <span class="text-xs text-emerald-300 font-medium">Online</span>
                            </div>
                        </div>
                    </div>
                    <p class="text-sm text-slate-200/80 glass-inset rounded-xl px-4 py-3 italic leading-relaxed">
                        "Your blood pressure looks good this week — keep logging daily!"
                    </p>
                    <p class="text-xs text-white/30 mt-2 text-right">Today, 9:12 AM</p>
                </div>
            </div>

            <!-- Trend Chart -->
            <div class="glass rounded-2xl p-5 card-lift anim-fade-up delay-400">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm font-semibold text-white">Heart Rate — 7-day Trend</p>
                        <p class="text-xs text-white/40 mt-0.5">bpm · last 7 days</p>
                    </div>
                    <span class="px-3 py-1 bg-sky-500/20 text-sky-400 text-xs font-semibold rounded-full border border-sky-500/30">Avg 74 bpm</span>
                </div>
                <div class="w-full overflow-x-auto">
                    <svg viewBox="0 0 560 120" xmlns="http://www.w3.org/2000/svg" class="w-full">
                        <line x1="0" y1="20" x2="560" y2="20" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
                        <line x1="0" y1="60" x2="560" y2="60" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
                        <line x1="0" y1="100" x2="560" y2="100" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
                        <defs>
                            <linearGradient id="hrGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.3"/>
                                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <polygon points="0,80 80,60 160,70 240,50 320,55 400,45 480,65 560,60 560,120 0,120" fill="url(#hrGrad)"/>
                        <polyline points="0,80 80,60 160,70 240,50 320,55 400,45 480,65 560,60"
                                  fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="0"   cy="80" r="4" fill="#38bdf8"/>
                        <circle cx="80"  cy="60" r="4" fill="#38bdf8"/>
                        <circle cx="160" cy="70" r="4" fill="#38bdf8"/>
                        <circle cx="240" cy="50" r="4" fill="#38bdf8"/>
                        <circle cx="320" cy="55" r="4" fill="#38bdf8"/>
                        <circle cx="400" cy="45" r="4" fill="#38bdf8"/>
                        <circle cx="480" cy="65" r="4" fill="#38bdf8"/>
                        <circle cx="560" cy="60" r="4" fill="#38bdf8"/>
                        @foreach (var (day, i) in Days.Select((d, i) => (d, i)))
                        {
                            @((MarkupString)$"<text x=\"{i * 80}\" y=\"118\" font-size=\"9\" fill=\"rgba(255,255,255,0.3)\" text-anchor=\"middle\">{day}</text>")
                        }
                    </svg>
                </div>
            </div>

            <!-- Medication Reminders -->
            <div class="glass rounded-2xl overflow-hidden card-lift anim-fade-up delay-600">
                <div class="px-5 py-4 border-b border-white/10">
                    <p class="text-sm font-semibold text-white">Medication Reminders</p>
                </div>
                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    @foreach (var m in Meds)
                    {
                        <div class="flex items-center gap-3 p-3.5 rounded-xl @(m.Taken ? "border border-emerald-500/20 bg-emerald-500/10" : "glass-inset")">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center text-lg flex-shrink-0 @(m.Taken ? "bg-emerald-500/20" : "glass-inset")">💊</div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-white">@m.Name</p>
                                <p class="text-xs text-white/50">@m.Dose · @m.Time</p>
                            </div>
                            @if (m.Taken)
                            {
                                <span class="text-emerald-400 text-xs font-semibold shrink-0">✓ Taken</span>
                            }
                            else
                            {
                                <button @onclick="() => m.Taken = true"
                                        class="text-xs font-medium text-sky-400 hover:text-sky-300 transition shrink-0">
                                    Mark taken
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

        </main>
    </div>
</div>

@code {
    string[] Days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    record SidebarItem(string Icon, string Label, string Href, bool Active);
    SidebarItem[] SidebarItems = [
        new("fa-solid fa-house", "Dashboard",      "/dashboard", true),
        new("fa-solid fa-heart-pulse",  "My Health",     "#",          false),
        new("fa-solid fa-clipboard-list", "Health History", "#",          false),
        new("fa-solid fa-pills",    "Medications",    "#",          false),
        new("fa-solid fa-star", "Rate Doctor",    "/feedback",  false),
        new("fa-solid fa-comments",       "Messages",       "#",          false),
        new("fa-solid fa-user",         "Profile",        "#",          false),
    ];

    record VitalCard(string Label, string Value, string Unit, string Status, string BadgeClass);
    VitalCard[] Vitals = [
        new("Blood Pressure", "118/76", "mmHg", "Normal",  "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"),
        new("Heart Rate",     "72",     "bpm",  "Normal",  "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"),
        new("Temperature",    "36.5",   "°C",   "Normal",  "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"),
        new("Blood Oxygen",   "98",     "%",    "Normal",  "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"),
        new("Weight",         "68.2",   "kg",   "Monitor", "bg-amber-500/20 text-amber-300 border border-amber-500/30"),
    ];

    class Medication
    {
        public string Name = "";
        public string Dose = "";
        public string Time = "";
        public bool Taken = false;
    }
    Medication[] Meds = [
        new() { Name = "Amlodipine", Dose = "5 mg",   Time = "8:00 AM",  Taken = true  },
        new() { Name = "Metformin",  Dose = "500 mg",  Time = "12:00 PM", Taken = false },
        new() { Name = "Vitamin D3", Dose = "1000 IU", Time = "8:00 AM",  Taken = true  },
        new() { Name = "Losartan",   Dose = "25 mg",   Time = "8:00 PM",  Taken = false },
    ];
}
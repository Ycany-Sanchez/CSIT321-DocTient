@page "/dashboard"
@inject NavigationManager Nav

<div class="min-h-screen flex">

    <!-- Sidebar -->
    <aside class="hidden md:flex flex-col w-64 bg-white/10 backdrop-blur-xl border-r border-white/10 fixed inset-y-0 left-0 z-30">
        <!-- Logo -->
        <div class="px-6 h-16 flex items-center border-b border-white/10 flex-shrink-0">
            <a href="/" class="flex items-center gap-2.5">
                <div class="w-8 h-8 bg-sky-500 rounded-lg flex items-center justify-center shadow-lg shadow-sky-500/40">
                    <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <span class="text-base font-bold text-white" style="font-family:'DM Sans',sans-serif">DocTient</span>
            </a>
        </div>
        <!-- Patient -->
        <div class="px-5 py-5 border-b border-white/10 flex-shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-sky-500/20 border border-sky-500/30 rounded-full flex items-center justify-center text-sky-400 text-sm font-bold flex-shrink-0">AR</div>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-white truncate">Alex Reyes</p>
                    <p class="text-xs text-white/40 truncate">Patient</p>
                </div>
            </div>
        </div>
        <!-- Nav -->
        <nav class="flex-1 px-4 py-4 space-y-0.5 overflow-y-auto">
            @foreach (var item in SidebarItems)
            {
                <a href="@item.Href"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition-all @(item.Active ? "bg-sky-500/20 text-sky-300 border border-sky-500/20 font-semibold" : "text-white/50 hover:bg-white/10 hover:text-white")">
                    <span class="text-base">@item.Icon</span>
                    @item.Label
                </a>
            }
        </nav>
        <!-- Logout -->
        <div class="px-4 py-5 border-t border-white/10 flex-shrink-0">
            <button @onclick='() => Nav.NavigateTo("/login")'
                    class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-white/40 hover:bg-red-500/10 hover:text-red-400 transition-all">
                <span class="text-base">🚪</span> Sign Out
            </button>
        </div>
    </aside>

    <!-- Main -->
    <div class="flex-1 md:ml-64 flex flex-col min-h-screen">

        <!-- Top bar -->
        <header class="sticky top-0 z-20 bg-white/5 backdrop-blur-xl border-b border-white/10 flex-shrink-0">
            <div class="px-6 h-16 flex items-center justify-between">
                <div>
                    <h1 class="text-sm font-semibold text-white">Good morning, Alex 👋</h1>
                    <p class="text-xs text-white/40">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
                </div>
                <div class="flex items-center gap-2">
                    <button class="relative p-2 rounded-xl text-white/40 hover:bg-white/10 hover:text-white/80 transition">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border-2 border-transparent animate-pulse"></span>
                    </button>
                    <div class="w-8 h-8 bg-sky-500/20 border border-sky-500/30 rounded-full flex items-center justify-center text-sky-400 text-xs font-bold">AR</div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <main class="flex-1 px-6 py-6 max-w-6xl mx-auto w-full space-y-6">

            <!-- Vitals Cards -->
            <div>
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-sm font-semibold text-white">Today's Vitals</h2>
                    <span class="text-xs text-white/40">Last logged: 7:30 AM today</span>
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
                    @foreach (var v in Vitals)
                    {
                        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-4 shadow-lg shadow-black/10 hover:bg-white/15 hover:border-white/30 transition-all duration-300">
                            <div class="text-xl mb-2">@v.Icon</div>
                            <p class="text-xs text-white/40 mb-1">@v.Label</p>
                            <p class="text-base font-bold text-white leading-tight">@v.Value</p>
                            <p class="text-[11px] text-white/30 mt-0.5">@v.Unit</p>
                            <span class="inline-block mt-2 px-2 py-0.5 rounded-full text-[10px] font-medium @v.BadgeClass">@v.Status</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Doctor + Quick Actions row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Doctor card -->
                <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-5 shadow-lg shadow-black/10">
                    <p class="text-xs font-semibold text-white/40 uppercase tracking-wider mb-4">Your Doctor</p>
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-12 h-12 bg-sky-500 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0 shadow-lg shadow-sky-500/30">RC</div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-white">Dr. Rafael Cruz</p>
                            <p class="text-xs text-white/50">General Practitioner · Makati Med</p>
                            <div class="flex items-center gap-1.5 mt-1">
                                <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
                                <span class="text-xs text-emerald-400 font-medium">Online</span>
                            </div>
                        </div>
                    </div>
                    <p class="text-sm text-white/60 bg-white/5 border border-white/10 rounded-xl px-4 py-3 italic leading-relaxed">
                        "Your blood pressure looks good this week — keep logging daily!"
                    </p>
                    <p class="text-xs text-white/30 mt-2 text-right">Today, 9:12 AM</p>
                </div>

                <!-- Quick actions -->
                <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-5 shadow-lg shadow-black/10">
                    <p class="text-xs font-semibold text-white/40 uppercase tracking-wider mb-4">Quick Actions</p>
                    <div class="space-y-2">
                        @foreach (var a in QuickActions)
                        {
                            <button class="w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 hover:bg-sky-500/10 hover:text-sky-300 border border-white/10 hover:border-sky-500/20 text-white/60 text-sm font-medium transition-all text-left">
                                <span class="text-lg">@a.Icon</span>
                                @a.Label
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Trend Chart -->
            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-5 shadow-lg shadow-black/10">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm font-semibold text-white">Heart Rate — 7-day Trend</p>
                        <p class="text-xs text-white/40 mt-0.5">bpm · last 7 days</p>
                    </div>
                    <span class="px-3 py-1 bg-sky-500/20 text-sky-400 text-xs font-semibold rounded-full border border-sky-500/30">Avg 74 bpm</span>
                </div>
                <div class="w-full overflow-x-auto">
                    <svg viewBox="0 0 560 120" xmlns="http://www.w3.org/2000/svg" class="w-full">
                        <line x1="0" y1="20" x2="560" y2="20" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
                        <line x1="0" y1="60" x2="560" y2="60" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
                        <line x1="0" y1="100" x2="560" y2="100" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
                        <defs>
                            <linearGradient id="hrGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.3"/>
                                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <polygon points="0,80 80,60 160,70 240,50 320,55 400,45 480,65 560,60 560,120 0,120" fill="url(#hrGrad)"/>
                        <polyline points="0,80 80,60 160,70 240,50 320,55 400,45 480,65 560,60"
                                  fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="0"   cy="80" r="4" fill="#38bdf8"/>
                        <circle cx="80"  cy="60" r="4" fill="#38bdf8"/>
                        <circle cx="160" cy="70" r="4" fill="#38bdf8"/>
                        <circle cx="240" cy="50" r="4" fill="#38bdf8"/>
                        <circle cx="320" cy="55" r="4" fill="#38bdf8"/>
                        <circle cx="400" cy="45" r="4" fill="#38bdf8"/>
                        <circle cx="480" cy="65" r="4" fill="#38bdf8"/>
                        <circle cx="560" cy="60" r="4" fill="#38bdf8"/>
                        @foreach (var (day, i) in Days.Select((d, i) => (d, i)))
                        {
                            @((MarkupString)$"<text x=\"{i * 80}\" y=\"118\" font-size=\"9\" fill=\"rgba(255,255,255,0.3)\" text-anchor=\"middle\">{day}</text>")
                        }
                    </svg>
                </div>
            </div>

            <!-- Recent Health Records -->
            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl shadow-lg shadow-black/10 overflow-hidden">
                <div class="px-5 py-4 border-b border-white/10 flex items-center justify-between">
                    <p class="text-sm font-semibold text-white">Recent Health Records</p>
                    <span class="text-xs text-white/40">Last 5 entries</span>
                </div>
                @foreach (var r in Records)
                {
                    <div class="px-5 py-3.5 flex items-center gap-4 hover:bg-white/5 transition border-b border-white/5 last:border-0">
                        <div class="text-white/20 text-sm w-5 shrink-0">📋</div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-white">@r.Type</p>
                            <p class="text-xs text-white/40">@r.Date</p>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="text-sm font-semibold text-white">@r.Value</p>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-medium @r.BadgeClass">@r.Status</span>
                        </div>
                    </div>
                }
            </div>

            <!-- Medication Reminders -->
            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl shadow-lg shadow-black/10 overflow-hidden">
                <div class="px-5 py-4 border-b border-white/10">
                    <p class="text-sm font-semibold text-white">Medication Reminders</p>
                </div>
                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    @foreach (var m in Meds)
                    {
                        <div class="flex items-center gap-3 p-3.5 rounded-xl border @(m.Taken ? "border-emerald-500/20 bg-emerald-500/10" : "border-white/10 bg-white/5")">
                            <div class="w-9 h-9 rounded-xl flex items-center justify-center text-lg flex-shrink-0 @(m.Taken ? "bg-emerald-500/20" : "bg-white/10 border border-white/10")">💊</div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-white">@m.Name</p>
                                <p class="text-xs text-white/50">@m.Dose · @m.Time</p>
                            </div>
                            @if (m.Taken)
                            {
                                <span class="text-emerald-400 text-xs font-semibold shrink-0">✓ Taken</span>
                            }
                            else
                            {
                                <button @onclick="() => m.Taken = true"
                                        class="text-xs font-medium text-sky-400 hover:text-sky-300 transition shrink-0">
                                    Mark taken
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

        </main>
    </div>
</div>

@code {
    string[] Days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    record SidebarItem(string Icon, string Label, string Href, bool Active);
    SidebarItem[] SidebarItems = [
        new("🏠", "Dashboard",      "/dashboard", true),
        new("❤️",  "My Health",     "#",          false),
        new("📋", "Health History", "#",          false),
        new("💊", "Medications",    "#",          false),
        new("💬", "Messages",       "#",          false),
        new("👤", "Profile",        "#",          false),
    ];

    record VitalCard(string Icon, string Label, string Value, string Unit, string Status, string BadgeClass);
    VitalCard[] Vitals = [
        new("❤️",  "Blood Pressure", "118/76", "mmHg", "Normal",  "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"),
        new("💓", "Heart Rate",     "72",     "bpm",  "Normal",  "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"),
        new("🌡️", "Temperature",    "36.5",   "°C",   "Normal",  "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"),
        new("🫁", "Blood Oxygen",   "98",     "%",    "Normal",  "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30"),
        new("⚖️",  "Weight",         "68.2",   "kg",   "Monitor", "bg-amber-500/20 text-amber-300 border border-amber-500/30"),
    ];

    record QuickAction(string Icon, string Label);
    QuickAction[] QuickActions = [
        new("➕", "Log Vitals"),
        new("💬", "Message Dr. Cruz"),
        new("📅", "Request Appointment"),
    ];

    class HealthRecord
    {
        public string Type = "";
        public string Date = "";
        public string Value = "";
        public string Status = "";
        public string BadgeClass = "";
    }
    HealthRecord[] Records = [
        new() { Type = "Blood Pressure", Date = "Sep 17 · 7:30 AM", Value = "118/76 mmHg", Status = "Normal",  BadgeClass = "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" },
        new() { Type = "Heart Rate",     Date = "Sep 16 · 8:15 AM", Value = "75 bpm",      Status = "Normal",  BadgeClass = "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" },
        new() { Type = "Blood Oxygen",   Date = "Sep 15 · 7:45 AM", Value = "97%",         Status = "Normal",  BadgeClass = "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" },
        new() { Type = "Temperature",    Date = "Sep 14 · 9:00 AM", Value = "37.1 °C",     Status = "Monitor", BadgeClass = "bg-amber-500/20 text-amber-300 border border-amber-500/30" },
        new() { Type = "Weight",         Date = "Sep 13 · 8:00 AM", Value = "68.0 kg",     Status = "Monitor", BadgeClass = "bg-amber-500/20 text-amber-300 border border-amber-500/30" },
    ];

    class Medication
    {
        public string Name = "";
        public string Dose = "";
        public string Time = "";
        public bool Taken = false;
    }
    Medication[] Meds = [
        new() { Name = "Amlodipine", Dose = "5 mg",   Time = "8:00 AM",  Taken = true  },
        new() { Name = "Metformin",  Dose = "500 mg",  Time = "12:00 PM", Taken = false },
        new() { Name = "Vitamin D3", Dose = "1000 IU", Time = "8:00 AM",  Taken = true  },
        new() { Name = "Losartan",   Dose = "25 mg",   Time = "8:00 PM",  Taken = false },
    ];
}

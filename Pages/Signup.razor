@page "/signup"
@inject NavigationManager Nav

<div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">

        <!-- Logo -->
        <div class="text-center mb-8 anim-fade-up">
            <div class="inline-flex items-center gap-2.5 mb-6">
                <div class="w-9 h-9 bg-sky-500 rounded-xl flex items-center justify-center shadow-lg shadow-sky-500/40">
                    <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </div>
                <span class="text-xl font-bold text-white" style="font-family:'DM Sans',sans-serif">DocTient</span>
            </div>
            <h1 class="text-2xl font-bold text-white mb-1" style="font-family:'DM Sans',sans-serif">Create your account</h1>
            <p class="text-sm text-white/50">Get started for free — no credit card required</p>
        </div>

        <!-- Card -->
        <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl shadow-2xl shadow-black/40 p-7 card-lift anim-fade-up delay-100">

            <!-- Role tabs -->
            <div class="flex bg-white/10 rounded-xl p-1 mb-6 border border-white/10">
                <button @onclick='() => Role = "patient"'
                        class="flex-1 py-2 text-sm font-medium rounded-lg transition @(Role == "patient" ? "bg-white/20 text-white shadow-sm" : "text-white/40 hover:text-white/70")">
                    I'm a Patient
                </button>
                <button @onclick='() => Role = "doctor"'
                        class="flex-1 py-2 text-sm font-medium rounded-lg transition @(Role == "doctor" ? "bg-white/20 text-white shadow-sm" : "text-white/40 hover:text-white/70")">
                    I'm a Doctor
                </button>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMsg))
            {
                <div class="mb-4 px-4 py-3 bg-red-500/20 border border-red-500/30 rounded-xl text-sm text-red-300 backdrop-blur-sm">
                    @ErrorMsg
                </div>
            }

            <!-- Name row -->
            <div class="flex gap-3 mb-4">
                <div class="flex-1">
                    <label class="block text-sm font-medium text-white/70 mb-1.5">First name</label>
                    <input @bind="FirstName" type="text" placeholder="Alex"
                           class="w-full px-3.5 py-2.5 text-sm border border-white/20 rounded-xl bg-white/10 backdrop-blur-sm text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-400/50 transition" />
                </div>
                <div class="flex-1">
                    <label class="block text-sm font-medium text-white/70 mb-1.5">Last name</label>
                    <input @bind="LastName" type="text" placeholder="Reyes"
                           class="w-full px-3.5 py-2.5 text-sm border border-white/20 rounded-xl bg-white/10 backdrop-blur-sm text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-400/50 transition" />
                </div>
            </div>

            <!-- Email -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-white/70 mb-1.5">Email address</label>
                <input @bind="Email" type="email" placeholder="you@email.com"
                       class="w-full px-3.5 py-2.5 text-sm border border-white/20 rounded-xl bg-white/10 backdrop-blur-sm text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-400/50 transition" />
            </div>

            @if (Role == "doctor")
            {
                <div class="mb-4">
                    <label class="block text-sm font-medium text-white/70 mb-1.5">Specialty</label>
                    <select @bind="Specialty"
                            class="w-full px-3.5 py-2.5 text-sm border border-white/20 rounded-xl bg-white/10 backdrop-blur-sm text-white focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-400/50 transition">
                        <option value="" class="bg-slate-800 text-white">Select specialty</option>
                        <option class="bg-slate-800 text-white">General Practitioner</option>
                        <option class="bg-slate-800 text-white">Cardiologist</option>
                        <option class="bg-slate-800 text-white">Internist</option>
                        <option class="bg-slate-800 text-white">Pulmonologist</option>
                        <option class="bg-slate-800 text-white">Endocrinologist</option>
                    </select>
                </div>
            }

            <!-- Password -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-white/70 mb-1.5">Password</label>
                <input @bind="Password" type="password" placeholder="Min. 8 characters"
                       class="w-full px-3.5 py-2.5 text-sm border border-white/20 rounded-xl bg-white/10 backdrop-blur-sm text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-400/50 transition" />
            </div>

            <!-- Confirm Password -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-white/70 mb-1.5">Confirm password</label>
                <input @bind="Confirm" type="password" placeholder="Re-enter password"
                       class="w-full px-3.5 py-2.5 text-sm border border-white/20 rounded-xl bg-white/10 backdrop-blur-sm text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-400/50 transition" />
            </div>

            <!-- Submit -->
            <button @onclick="HandleSignup" disabled="@Loading"
                    class="w-full py-2.5 text-sm font-semibold text-white bg-sky-500 hover:bg-sky-400 rounded-xl transition shadow-lg shadow-sky-500/30 disabled:opacity-50 disabled:cursor-not-allowed">
                @(Loading ? "Creating account..." : "Create Account")
            </button>

            <p class="text-center text-xs text-white/30 mt-5 mb-0">
                By signing up you agree to our
                <a href="#" class="text-sky-400 hover:text-sky-300">Terms</a> and
                <a href="#" class="text-sky-400 hover:text-sky-300">Privacy Policy</a>.
            </p>

            <p class="text-center text-sm text-white/40 mt-4">
                Already have an account?
                <a href="/login" class="text-sky-400 font-medium hover:text-sky-300 transition">Sign in</a>
            </p>
        </div>

        <p class="text-center mt-6">
            <a href="/" class="text-xs text-white/30 hover:text-white/60 transition">← Back to home</a>
        </p>
    </div>
</div>

@code {
    string Role = "patient";
    string FirstName = "";
    string LastName = "";
    string Email = "";
    string Specialty = "";
    string Password = "";
    string Confirm = "";
    string ErrorMsg = "";
    bool Loading = false;

    async Task HandleSignup()
    {
        ErrorMsg = "";
        if (string.IsNullOrWhiteSpace(FirstName) || string.IsNullOrWhiteSpace(LastName) ||
            string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            ErrorMsg = "Please fill in all required fields.";
            return;
        }
        if (Password != Confirm)
        {
            ErrorMsg = "Passwords do not match.";
            return;
        }
        if (Password.Length < 8)
        {
            ErrorMsg = "Password must be at least 8 characters.";
            return;
        }
        Loading = true;
        await Task.Delay(900);
        Nav.NavigateTo("/dashboard");
    }
}
